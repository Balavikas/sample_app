<% if @user.errors.any? %>
    <div id="error-explanation">
        <div class="alert alert-danger">
            The form has <%= pluralize(@user.errors.count, 'error') %>
        </div>

        <div>
            <ul>
                <% @user.errors.full_messages.each do |msg| %>
                    <li>
                        <%= msg %>
                    </li>
                <% end %>
            </ul>
        </div>
    </div>
<% end %>